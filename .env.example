APP_ENV=develop
APP_NAME=platform
APP_LOG_LEVEL=info
APP_JWT_SECRET=my-secret-key

## DATABASES
APP_POSTGRES_MASTER_DSN=postgres://app:password@postgres-master:5432/app?sslmode=disable
APP_POSTGRES_REPLICA_DSN=postgres://app:password@postgres-replica:5433/app?sslmode=disable


APP_MARIADB_DSN=app:password@tcp(localhost:3306)/app?parseTime=true&charset=utf8mb4
APP_CLICKHOUSE_DSN=http://app:password@localhost:8123/app


## DEV container
CONTAINER_POSTGRES_DB_MASTER_PORT=5445
CONTAINER_POSTGRES_DB_REPLICA_PORT=5446

CONTAINER_MARIA_DB_PORT=3307
CONTAINER_CLICKHOUSE_DB_PORT=9099
CONTAINER_CLICKHOUSE_DB_INTERFACE_PORT=8124
