APP_ENV=develop
APP_NAME=platform
APP_LOG_LEVEL=info
APP_JWT_SECRET=my-secret-key

## DATABASES
APP_POSTGRES_MASTER_DSN=postgres://app:password@postgres-master:5432/app?sslmode=disable
APP_POSTGRES_REPLICA_1_DSN=postgres://app:password@postgres-replica:5432/app?sslmode=disable


APP_MARIADB_DSN=app:password@tcp(mariadb-db:3306)/app?parseTime=true&charset=utf8mb4
APP_CLICKHOUSE_DSN=http://app:password@clickhouse-db:8123/app


## CACHE
REDIS_PASSWORD=password
APP_CACHE_MAIN_DSN=redis://default:password@redis:6379/0
APP_CACHE_SESSIONS_DSN=redis://default:password@redis:6379/1

## DEV container
CONTAINER_POSTGRES_DB_MASTER_PORT=5445
CONTAINER_POSTGRES_DB_REPLICA_PORT=5446

CONTAINER_MARIA_DB_PORT=3307
CONTAINER_CLICKHOUSE_DB_PORT=9099
CONTAINER_CLICKHOUSE_DB_INTERFACE_PORT=8124
